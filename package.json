{
  "name": "seedinspect",
  "version": "1.0.0",
  "private": true,
  "description": "Offline Bitcoin BIP39 analysis, generation, and address derivation",
  "license": "MIT",
  "type": "module",
  "engines": { "node": "24.21.0" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/core.test.ts",
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test && npm run build:check",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@scure/btc-signer": "2.4.1"
  },
  "devDependencies": {
    "@bitcoinerlab/secp256k1": "2.0.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "bip32": "5.0.1",
    "bitcoinjs-lib": "7.0.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
